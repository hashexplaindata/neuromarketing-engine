# ==============================================================================
# GPU Worker Dockerfile with NVIDIA Container Runtime
# Neuromarketing Studio Pipeline - Accelerated Inference Worker
# ==============================================================================

# CUDA Runtime with Python 3.11. Model weights are downloaded from their
# verified upstream checkpoints at first worker start and cached under /app/models.
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV TORCH_HOME=/app/models/torch
ENV YOLO_CONFIG_DIR=/app/models/ultralytics
ENV EASYOCR_MODULE_PATH=/app/models/easyocr
ENV HOME=/app

WORKDIR /app

# Install system dependencies, Python 3.11, OpenCV & WeasyPrint graphics dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    build-essential \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libpango-1.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    libffi-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# Install Python requirements + GPU Acceleration runtime
COPY requirements-worker.txt .
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir -r requirements-worker.txt && \
    pip3 install --no-cache-dir onnxruntime-gpu celery redis

# Copy source code
COPY . /app/

# Create ephemeral workspaces mount directory
RUN mkdir -p /app/ephemeral_workspaces /tmp/neuromarketing /app/models/torch /app/models/ultralytics /app/models/easyocr

# Modal invokes one isolated task through modal_app.py; keep a neutral module entrypoint for local diagnostics.
CMD ["python3", "-m", "workers.modal_worker"]
