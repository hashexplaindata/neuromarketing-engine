# ==============================================================================
# ICM Neuromarketing Engine - Cloud Environment Blueprint
# Heroku + Appwrite + Upstash Redis + Camber Cloud Stack
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME=ICM Neuromarketing Engine
PORT=8000

# Appwrite BaaS (Auth, Database, Storage)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=neuromarketing-engine
APPWRITE_API_KEY=appwrite_secret_api_key_here
APPWRITE_DATABASE_ID=neuromarketing_db
APPWRITE_JOBS_COLLECTION_ID=jobs
APPWRITE_STORAGE_BUCKET_ID=assets

# Upstash Redis (Task Queue & Real-Time Pub/Sub)
UPSTASH_REDIS_URL=rediss://default:your_password@your-endpoint.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Camber Cloud (GPU Workers)
CAMBER_WORKER_POOL=camber-gpu-t4-cluster
CAMBER_API_KEY=your_camber_cloud_api_key_here

# Ephemeral Workspace Path
EPHEMERAL_ROOT=/tmp/neuromarketing

# Local Fallback JWT Secret
JWT_SECRET_KEY=icm-appwrite-upstash-camber-secret-key-2026
