# NEUROMARKETING STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in credentials locally. Never commit .env.
# ========================================================================

# --- Appwrite Cloud BaaS ---
VITE_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="your_appwrite_project_id"
VITE_APPWRITE_PROJECT_NAME="Neuromarketing Studio"
APPWRITE_API_KEY="your_appwrite_api_key"
APPWRITE_DATABASE_ID="your_appwrite_database_id"
APPWRITE_STORAGE_BUCKET_ID="your_appwrite_storage_bucket_id"
APPWRITE_PROVIDER_FIELDS_ENABLED="false"

# --- Modal GPU execution provider ---
GPU_PROVIDER="modal"
MODAL_APP_NAME="neuromarketing-studio"
MODAL_FUNCTION_NAME="process_job"
MODAL_ENVIRONMENT="staging"
MODAL_TOKEN_ID="your_modal_service_user_token_id"
MODAL_TOKEN_SECRET="your_modal_service_user_token_secret"

# --- Google Gemini multimodal assistance ---
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"

# --- API and tenant security ---
ENVIRONMENT="development"
DEBUG="false"
JWT_SECRET_KEY="replace_with_a_long_random_secret"
CORS_ORIGINS="http://localhost:5173"

# --- Optional local artifact settings ---
EPHEMERAL_ROOT="/tmp/neuromarketing"
MODELS_DIR="/app/models"
ONNX_EXECUTION_PROVIDER="CUDAExecutionProvider"
