# ====================================================================
# NEUROMARKETING SUITE V5 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your credentials.
# ====================================================================

# --- Appwrite Cloud BaaS ---
VITE_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="your_appwrite_project_id"
VITE_APPWRITE_PROJECT_NAME="NeuromarketingEngine"
APPWRITE_API_KEY="your_appwrite_api_key"
APPWRITE_DATABASE_ID="NeuromarketingDB"
APPWRITE_STORAGE_BUCKET_ID="neuromarketing-assets"

# --- Upstash Redis Queue ---
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# --- Camber Cloud GPU Cluster ---
CAMBER_API_KEY="your_camber_api_key"
CAMBER_WORKER_POOL="l4-gpu-cluster-01"

# --- Google Gemini Multimodal Interactivity ---
GEMINI_API_KEY="your_gemini_api_key"