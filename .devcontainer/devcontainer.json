{
  "name": "Neuromarketing Studio Codespace",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8000, 3000],
  "postCreateCommand": "pip install -r requirements.txt && cd studio && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}